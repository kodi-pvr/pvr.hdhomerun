msgstr "Klient PVR pro HDHomeRun"

msgctxt "Addon Description"
msgid "HDHomeRun PVR Client"
msgstr "Klient PVR pro HDHomeRun"

#. label-category: general
msgctxt "#32001"
msgid "General"
msgstr "Obecné"

msgctxt "#32002"
msgid "Hide protected channels"
msgstr "Skrýt chráněné kanály"

msgctxt "#32003"
msgid "Enable debug logging"
msgstr "Povolit protokolování ladění"

msgctxt "#32004"
msgid "Hide duplicate channels"
msgstr "Skrýt duplicitní kanály"

msgctxt "#32005"
msgid "Mark new show"
msgstr "Označit nový pořad"

#. label: Device Discovery - http_discovery
msgctxt "#32006"
msgid "Use HTTP discovery"
msgstr "Použít vyhledávání přes HTTP"

#. label: Device Discovery - force_ip
msgctxt "#32007"
msgid "Set IP of device to use"
msgstr "Nastavit IP adresu zařízení, které se má použít"

#. label-group: General - Device Discovery
msgctxt "#32008"
msgid "Device Discovery"
msgstr "Vyhledávání zařízení"

# empty strings from id 32009 to 320099
#. ############
#. help info #
#. ############
#. help info - General
#. help: Device Discovery - http_discovery
msgctxt "#32100"
msgid "This uses Silicondust web API to return HDHomeRun devices connected with the same internet IP address"
msgstr "Pomocí webového API Silicondust vyhledá zařízení HDHomeRun připojená ze stejné veřejné IP adresy"

#. help: Device Discovery - force_ip
msgctxt "#32101"
msgid "When other discovery methods do not work, enter an [B]IPv4[/B] address of a HDHomeRun device to explicitly search only that IP. This works when Broadcast and HTTP discovery do not find devices due to LAN/WAN differences in Client/Tuner. Restart Addon by Disabling and Enabling when changed."
msgstr "Pokud jiné metody vyhledávání nefungují, zadejte [B]IPv4[/B] adresu zařízení HDHomeRun, aby se explicitně hledala pouze tato IP adresa. Funguje to v případech, kdy vyhledávání pomocí Broadcast a HTTP nenajde zařízení kvůli rozdílům LAN/WAN mezi klientem a tunerem. Po změně doplněk restartujte jeho zakázáním a opětovným povolením."
